NODE_ENV=development
PORT=4000

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Значение по умолчанию совпадает с infra/docker/docker-compose.yml
DATABASE_URL=postgresql://gulyay:gulyay@localhost:5432/gulyay_db

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Для локальной разработки подойдёт любая строка; в проде — длинный случайный секрет
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# ─── Хранилище медиа (S3-совместимое) ────────────────────────────────────────
# По умолчанию — локальный MinIO из docker-compose. Бакет создаётся автоматически
# при первой загрузке файла. Для прода подставьте Yandex Object Storage / S3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=gulyay-media
S3_ACCESS_KEY=gulyay
S3_SECRET_KEY=gulyay123
S3_PUBLIC_URL=http://localhost:9000

# ─── ЮKassa (оплата — сейчас заглушка, можно не заполнять) ────────────────────
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=

# ─── Redis (в текущей версии не используется) ────────────────────────────────
REDIS_URL=redis://localhost:6379
